{
  "name": "dsh-subagent-a2a",
  "version": "0.0.1",
  "description": "A2A client provider plugin for DeepSeek Harness",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "scripts/build.sh",
    "scripts/build.ps1"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-session": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-subagent": ">=0.0.1-rc <2",
    "cordis": ">=4.0.0-rc <5",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:ps1": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
